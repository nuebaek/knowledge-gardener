# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env
# .env 에는 실제 키를 넣되, .env.example 에는 절대 실제 키를 넣지 마세요.

# === 생성 LLM (답변 생성) ===
LLM_PROVIDER=google                 # google(Gemini API) | ollama(로컬) | cerebras
LLM_FALLBACK_MODEL=gemini-3.5-flash # primary가 429 등으로 실패하면 이 Gemini로 폴백(호출마다
                                    # primary 먼저 시도 → rate limit 풀리면 자동 복귀). 비우면 폴백 off.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash       # 답변 생성 모델
# (선택) 로컬 LLM 사용 시
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434

# === 평가 Judge 모델 (생성 모델과 분리 — self-bias 최소화) ===
GOOGLE_EVAL_MODEL=gemini-3.5-flash  # baseline.py judge/relevancy 평가용

# === 벡터 DB (Chroma) ===
CHROMA_MODE=local                   # local(임베디드) | server | cloud
# server 모드일 때
CHROMA_HOST=localhost
CHROMA_PORT=8000
# cloud 모드일 때 (Chroma Cloud — 무료 티어 컬렉션당 300 레코드 제한)
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=your_database_name_here

# === LangSmith (추적 + Dataset 평가) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cs231n-rag
