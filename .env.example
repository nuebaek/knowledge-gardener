# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env
# ⚠️ .env 에는 실제 키를 넣되, .env.example 에는 절대 실제 키를 넣지 마세요(이 파일은 커밋됨).

# === 생성 LLM (답변 생성) ===
LLM_PROVIDER=google                 # google(Gemini API) | ollama(로컬)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash       # 답변 생성 모델
# (선택) 로컬 LLM 사용 시
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434

# === 평가 Judge 모델 ===
# Pro는 유료 전용이라 무료로는 못 씀. player(flash)보다 상위 세대인 무료 flash 권장.
JUDGE_MODEL=gemini-3.5-flash        # 미지원/오류 시 gemini-2.5-flash로 대체

# === 임베딩 ===
# 로컬 bge-m3 고정(코드). env로 바꾸지 않는다 — 대량·반복 호출이라 API 미사용.

# === 벡터 DB (Chroma) ===
CHROMA_MODE=local                   # local(임베디드) | server | cloud
# server 모드일 때
CHROMA_HOST=localhost
CHROMA_PORT=8000
# cloud 모드일 때 (Chroma Cloud — 무료 티어 컬렉션당 300 레코드 제한)
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=your_database_name_here

# === LangSmith (추적 + Dataset 평가) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cs231n-rag
