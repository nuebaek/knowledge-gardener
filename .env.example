# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env
# .env 에는 실제 키를 넣되, .env.example 에는 절대 실제 키를 넣지 마세요.

# === 생성 LLM (답변 생성) ===
LLM_PROVIDER=openrouter              # openrouter(기본) | exaone | cerebras | ollama(로컬)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free  # 무료: 20회/분, 50회/일($10 충전 이력 시 1000회/일)
                                     # 폴백: primary 실패(429 등) → EXAONE(키 있으면). 호출마다 primary 먼저 시도.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash       # gen_evalset.py --model google 전용(오프라인 데이터셋 생성, 프로덕션 미사용)
# (선택) 로컬 LLM 사용 시
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434
# LG K-EXAONE — 키가 있으면 primary 실패 시 1순위 폴백. LLM_PROVIDER=exaone이면 primary. 키는 docs.exaone.ai
EXAONE_API_KEY=your_exaone_api_key_here
EXAONE_MODEL=k-exaone_v2.5
EXAONE_REASONING_EFFORT=low          # low | high | max (API 기본값 max는 판정 1회 ~20초)

# === 평가 Judge 모델 (생성 모델과 분리 — self-bias 최소화) ===
GOOGLE_EVAL_MODEL=gemini-3.5-flash  # baseline.py judge/relevancy 평가용 (오프라인 스크립트 전용)

# === 오프라인 평가용 judge 모델 (benchmark.py, gen_evalset.py, run_judge_eval.py 전용) ===
# 앱의 study_turn은 생성 LLM(LLM_PROVIDER)을 그대로 쓴다. 유료 — 평가 스크립트를 돌릴 때만 필요.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_JUDGE_MODEL=claude-sonnet-5

# === 벡터 DB (Chroma) ===
CHROMA_MODE=local                   # local(임베디드) | server
# server 모드일 때
CHROMA_HOST=localhost
CHROMA_PORT=8000

# === LangSmith (추적 + Dataset 평가) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cs231n-rag
