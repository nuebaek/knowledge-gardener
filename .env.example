# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env
# .env 에는 실제 키를 넣되, .env.example 에는 절대 실제 키를 넣지 마세요.

# === 생성 LLM (답변 생성) ===
LLM_PROVIDER=cerebras                # cerebras | ollama(로컬)
LLM_FALLBACK_MODEL=claude-haiku-4-5  # primary(Cerebras) 429 등으로 실패하면 이 Claude Haiku로
                                     # 폴백(호출마다 primary 먼저 시도 → 풀리면 자동 복귀). 비우면
                                     # 폴백 off. 무료 티어(Gemini)는 모델별 일일 쿼터가 너무 빡빡해서
                                     # (실측 20회/day) judge 폴백·평가 스크립트와 계속 충돌했다 —
                                     # $10 예산으로 수천 콜은 거뜬해서 유료·안정 쪽으로 통일.
                                     # judge(LLM_JUDGE_MODEL)의 폴백도 이 값을 그대로 재사용한다.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash       # gen_evalset.py --model google 전용(오프라인 데이터셋 생성, 프로덕션 미사용)
# (선택) 로컬 LLM 사용 시
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434

# === 평가 Judge 모델 (생성 모델과 분리 — self-bias 최소화) ===
GOOGLE_EVAL_MODEL=gemini-3.5-flash  # baseline.py judge/relevancy 평가용 (오프라인 스크립트 전용)

# === 인출연습 판정(judge) 모델 — study_turn의 verdict 판정 전용 ===
# 생성(Cerebras)보다 정확도가 중요한 판정 지점이라 Claude Sonnet을 씀. 유료(예산 한도 있음) —
# 소진/장애 시 apply_fallback이 자동으로 LLM_FALLBACK_MODEL(Haiku, 생성 폴백과 공유)로 폴백한다.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_JUDGE_MODEL=claude-sonnet-5

# === 벡터 DB (Chroma) ===
CHROMA_MODE=local                   # local(임베디드) | server
# server 모드일 때
CHROMA_HOST=localhost
CHROMA_PORT=8000

# === LangSmith (추적 + Dataset 평가) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cs231n-rag
